[Unit]
Description=CYPHERYN authorized scanner egress policy
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Comma-separated exact IPs. Extend this list only for targets whose active
# assessment has been explicitly authorized.
Environment=CYPHERYN_AUTHORIZED_TARGET_IPS=172.31.250.2
ExecStart=/usr/local/sbin/configure-cypheryn-scanner-egress
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
