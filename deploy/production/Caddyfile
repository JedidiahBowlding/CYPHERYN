{
	email {$ACME_EMAIL}
	admin off
}

app.cypheryn.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	route {
		handle /oauth2/* {
			reverse_proxy oauth2-proxy:4180
		}

		# The product landing page is public. Its calls to action point to
		# authenticated application routes handled below.
		handle / {
			reverse_proxy frontend:3000
		}

		@public_assets path /_next/* /favicon.png /apple-touch-icon.png /cypheryn-logo.png
		handle @public_assets {
			reverse_proxy frontend:3000
		}

		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers Authorization X-Auth-Request-User X-Auth-Request-Email
			@unauthorized status 401
			handle_response @unauthorized {
				redir * /oauth2/start?rd={scheme}://{host}{uri}
			}
		}

		@api path /api/* /health/* /metrics
		handle @api {
			reverse_proxy api:8000 {
				header_up -X-Dev-Subject
				header_up -X-Dev-Email
			}
		}

		handle {
			reverse_proxy frontend:3000
		}
	}
}

cypheryn.com {
	redir https://app.cypheryn.com{uri} permanent
}
