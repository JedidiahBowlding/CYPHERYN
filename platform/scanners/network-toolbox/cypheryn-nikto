#!/usr/bin/env python3
"""Run Nikto while guaranteeing that stdout contains only its JSON report."""

import json
import pathlib
import subprocess
import sys
import time


def main() -> int:
    arguments = list(sys.argv[1:])
    report = pathlib.Path("/tmp/cypheryn-nikto.json")
    for index in range(len(arguments) - 1):
        if arguments[index].lower() in {"-output", "-o"} and arguments[index + 1] == "-":
            arguments[index + 1] = str(report)
            break
    else:
        print("Nikto wrapper requires '-output -'", file=sys.stderr)
        return 64

    completed = None
    for attempt in range(3):
        report.unlink(missing_ok=True)
        completed = subprocess.run(
            ["perl", "/opt/nikto/program/nikto.pl", *arguments],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if report.is_file():
            try:
                payload = json.loads(report.read_text(encoding="utf-8"))
                failures = [
                    finding
                    for host in payload if isinstance(host, dict)
                    for finding in (host.get("vulnerabilities") or [])
                    if str(finding.get("id") or "").upper() == "FAIL"
                ]
            except (json.JSONDecodeError, TypeError):
                failures = []
            if not failures:
                break
        if attempt < 2:
            time.sleep(5 * (attempt + 1))
    assert completed is not None
    if not report.is_file():
        print((completed.stderr or "Nikto did not produce a JSON report")[-1000:], file=sys.stderr)
        return completed.returncode if completed.returncode not in {0, 1} else 2
    sys.stdout.write(report.read_text(encoding="utf-8"))
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
