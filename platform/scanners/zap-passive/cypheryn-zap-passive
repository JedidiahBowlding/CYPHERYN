#!/usr/bin/env python3
import json
import pathlib
import subprocess
import sys
import urllib.parse


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: cypheryn-zap-passive <authorized-url>", file=sys.stderr)
        return 64
    target = sys.argv[1]
    parsed = urllib.parse.urlsplit(target)
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
        print("only credential-free HTTPS targets are accepted", file=sys.stderr)
        return 64
    work = pathlib.Path("/tmp/cypheryn-zap")
    work.mkdir(mode=0o700)
    plan = work / "passive.yaml"
    report = work / "report.json"
    plan.write_text(
        "env:\n"
        "  contexts:\n"
        "  - name: CYPHERYN\n"
        f"    urls: [{json.dumps(target)}]\n"
        "jobs:\n"
        "- type: spider\n"
        "  parameters:\n"
        "    context: CYPHERYN\n"
        "    maxDuration: 1\n"
        "    maxDepth: 2\n"
        "- type: passiveScan-wait\n"
        "  parameters:\n"
        "    maxDuration: 2\n"
        "- type: report\n"
        "  parameters:\n"
        "    template: traditional-json\n"
        f"    reportDir: {json.dumps(str(work))}\n"
        "    reportFile: report.json\n",
        encoding="utf-8",
    )
    completed = subprocess.run(
        ["/zap/zap.sh", "-cmd", "-silent", "-dir", str(work), "-autorun", str(plan)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        timeout=150,
        check=False,
    )
    if not report.is_file():
        print((completed.stderr or "ZAP did not produce a report")[-1000:], file=sys.stderr)
        return completed.returncode or 1
    payload = json.loads(report.read_text(encoding="utf-8"))
    compact_sites = []
    for site in payload.get("site", []) if isinstance(payload, dict) else []:
        compact_alerts = []
        for alert in (site.get("alerts", []) or [])[:500]:
            compact_alerts.append(
                {
                    "pluginid": alert.get("pluginid"),
                    "name": str(alert.get("name") or "")[:300],
                    "riskdesc": str(alert.get("riskdesc") or "")[:100],
                    "cweid": alert.get("cweid"),
                    "desc": str(alert.get("desc") or "")[:4000],
                    "solution": str(alert.get("solution") or "")[:4000],
                    "instances": [
                        {"uri": str(instance.get("uri") or target)[:2000]}
                        for instance in (alert.get("instances", []) or [{}])[:500]
                    ],
                }
            )
        compact_sites.append({"name": site.get("@name"), "alerts": compact_alerts})
    sys.stdout.write(json.dumps({"site": compact_sites}, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
