# Core host ports (change these if a port is already occupied)
FRONTEND_PORT=3000
API_PORT=8000
TAXII_PORT=9000
SPIDERFOOT_PORT=5001

# Core PostgreSQL database
POSTGRES_DB=cypheryn
POSTGRES_USER=cypheryn
POSTGRES_PASSWORD=GENERATE_WITH_PYTHON_SCRIPTS_SETUP_PY

# Required development security values
PLATFORM_PROVIDER_ENCRYPTION_KEY=GENERATE_WITH_PYTHON_SCRIPTS_SETUP_PY
TAXII_TOKEN=GENERATE_WITH_PYTHON_SCRIPTS_SETUP_PY
PLATFORM_ALLOW_DEV_IDENTITY=true
# API-local repository/SBOM imports must be relative to this isolated directory.
PLATFORM_LOCAL_IMPORT_ROOT=/var/lib/cypheryn/imports

# Optional OIDC authentication (leave blank for local development identity)
PLATFORM_OIDC_ISSUER=
PLATFORM_OIDC_AUDIENCE=cypheryn
PLATFORM_OIDC_JWKS_URL=

# Production Auth0 gateway (required only with compose.production.yaml)
AUTH0_CLIENT_ID=
AUTH_PROXY_SECRET=
ACME_EMAIL=
AUTH0_CLIENT_SECRET_FILE=./platform/.runtime/auth0-client-secret
OAUTH2_COOKIE_SECRET_FILE=./platform/.runtime/oauth2-cookie-secret
AUTHENTICATED_EMAILS_FILE=./platform/.runtime/authenticated-emails.txt

# Optional local AI (Ollama on the host)
PLATFORM_LOCAL_AI_URL=http://host.docker.internal:11434
PLATFORM_LOCAL_AI_MODEL=qwen2.5-coder:7b
PLATFORM_LOCAL_AI_TIMEOUT_SECONDS=120

# Optional disposable scanner images. Use explicit version tags or digests only.
# Active local scanner adapters fail closed when their image is not configured.
PLATFORM_ENVIRONMENT=development
PLATFORM_SCANNER_IMAGES={}
PLATFORM_SCANNER_NETWORK=bridge
# Required only when the scanner profile is enabled. Generated by scripts/setup.py.
SCANNER_ORCHESTRATOR_TOKEN=GENERATE_WITH_PYTHON_SCRIPTS_SETUP_PY
PLATFORM_SCANNER_ORCHESTRATOR_URL=http://scanner-orchestrator:8010
CYPHERYN_VERSION=development
# Production releases should set each image to an immutable registry digest,
# for example ghcr.io/owner/cypheryn-api@sha256:<digest>.
CYPHERYN_API_IMAGE=cypheryn-api
CYPHERYN_WORKER_IMAGE=cypheryn-worker
CYPHERYN_FRONTEND_IMAGE=cypheryn-frontend
CYPHERYN_TAXII_IMAGE=cypheryn-taxii
CYPHERYN_SCANNER_ORCHESTRATOR_IMAGE=cypheryn-scanner-orchestrator
CYPHERYN_EGRESS_PROXY_IMAGE=cypheryn-egress-proxy
CYPHERYN_PROTECTED_AGENT_PILOT_IMAGE=cypheryn-protected-agent-pilot
CYPHERYN_EGRESS_CADDY_IMAGE=caddy:2.10.2-alpine
CYPHERYN_EGRESS_PROXY_REPLICAS=3

# Optional remote Greenbone/OpenVAS bridge. Keep the bridge private and use a
# distinct random token of at least 32 characters.
OPENVAS_BRIDGE_URL=
OPENVAS_BRIDGE_TOKEN=

# Signed evidence anchors. The worker reads the private key, writes immutable bundles,
# and the API receives only read-only access to public anchor files.
PLATFORM_INTEGRITY_ANCHOR_ENABLED=true
PLATFORM_INTEGRITY_ANCHOR_INTERVAL_MINUTES=1440
PLATFORM_ANCHOR_KEY_DIR=./platform/.runtime/anchor-keys
PLATFORM_ANCHOR_STORE_DIR=./platform/.runtime/anchors

# Experimental federation. Disabled by default; it opens no additional port in core Compose.
PLATFORM_FEDERATION_ENABLED=false
PLATFORM_FEDERATION_DISPLAY_NAME=CYPHERYN Node
PLATFORM_FEDERATION_KEY_PATH=./platform/.runtime/federation/node.pem
PLATFORM_FEDERATION_MAX_ASSERTION_BYTES=65536
PLATFORM_FEDERATION_CLOCK_SKEW_SECONDS=300
PLATFORM_FEDERATION_RATE_LIMIT_PER_MINUTE=60

# Agent Egress Firewall. The API is loopback-bound by core Compose and all
# endpoints require the normal CYPHERYN identity plus organization membership.
PLATFORM_EGRESS_GUARD_ENABLED=true
PLATFORM_EGRESS_GUARD_BIND_HOST=127.0.0.1
PLATFORM_EGRESS_MAX_ARTIFACT_BYTES=5242880
PLATFORM_EGRESS_SCAN_TIMEOUT_SECONDS=15
PLATFORM_EGRESS_QUARANTINE_DIR=/data/quarantine/egress
PLATFORM_EGRESS_RATE_LIMIT_PER_MINUTE=120
PLATFORM_EGRESS_MANDATORY_SCANNERS='["builtin-patterns"]'
# Optional case-insensitive regular expressions; never place secret values here.
PLATFORM_EGRESS_ORGANIZATION_PATTERNS='[]'
PLATFORM_SECURITY_REQUEST_CLOCK_SKEW_SECONDS=300
# Short-lived execution authority and DNS binding lifetimes (5-300 and 5-120 seconds).
PLATFORM_SECURITY_AUTHORIZATION_TTL_SECONDS=60
PLATFORM_SECURITY_RESOLUTION_TTL_SECONDS=30

# Separately trusted Agent Egress Proxy. It remains disabled in the API settings
# and absent from the default Compose startup until the trusted-egress profile is selected.
PLATFORM_TRUSTED_EGRESS_PROXY_ENABLED=false
PLATFORM_TRUSTED_EGRESS_PROXY_MAX_REQUEST_BYTES=1048576
PLATFORM_TRUSTED_EGRESS_PROXY_MAX_RESPONSE_BYTES=5242880
PLATFORM_TRUSTED_EGRESS_PROXY_MAX_HEADER_BYTES=32768
PLATFORM_TRUSTED_EGRESS_PROXY_CONNECT_TIMEOUT_SECONDS=5
PLATFORM_TRUSTED_EGRESS_PROXY_READ_TIMEOUT_SECONDS=20
PLATFORM_TRUSTED_EGRESS_PROXY_VALIDATION_TIMEOUT_SECONDS=5
PLATFORM_TRUSTED_EGRESS_PROXY_MAX_REDIRECTS=3
# Generate local certification material with:
# python scripts/egress_pki.py init platform/.runtime/egress-mtls
PLATFORM_EGRESS_MTLS_DIR=./platform/.runtime/egress-mtls
EGRESS_PROXY_CLIENT_CERT_FILE=proxy-client.crt
EGRESS_PROXY_CLIENT_KEY_FILE=proxy-client.key
# Read-only pilot token; obtain through the configured workload identity provider.
PILOT_WORKLOAD_TOKEN_FILE=./platform/.runtime/pilot-workload-token

# Optional SMTP notifications
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM=
PLATFORM_SMTP_USE_TLS=true

# Optional services are enabled with Compose profiles, not required for core startup.
# Start bundled legacy SpiderFoot with: docker compose --profile spiderfoot up -d
# Start the trusted scanner runner with: docker compose --profile scanner up -d --build
# Start the trusted agent egress boundary with: docker compose --profile trusted-egress up -d --build
# Add the isolated read-only pilot with both profiles after provisioning its workload token.

# Threat-intelligence provider credentials are intentionally not stored here.
# Add them through CYPHERYN Settings; the API encrypts them before persistence.
